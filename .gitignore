# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/

# Virtual environments
venv/
traffic_env/
env/
.venv/

# Jupyter
.ipynb_checkpoints/

# Raw video formats
*.mp4
*.avi

# Model checkpoints (models/, and yolov8n.pt wherever it's downloaded to)
*.pt
*.pth
*.pkl
*.onnx
*.ckpt

# data/raw: full CityFlow download, never tracked
data/raw/*
!data/raw/.gitkeep

# data/frames: extracted frame images, keep metadata CSV
data/frames/**/*.jpg
data/frames/**/*.jpeg
data/frames/**/*.png
!data/frames/.gitkeep

# data/processed: keep final CSV datasets, ignore any image outputs
data/processed/*
!data/processed/.gitkeep
!data/processed/*.csv

# results/figures: generated comparison charts
results/figures/*
!results/figures/.gitkeep

# logs
*.log
logs/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# secrets
.env
.env.local
*.key

# Office temp files
~$*.docx
~$*.pptx
*.tmp
.~lock.*

# archives / cache
*.zip
*.tar.gz
.cache/